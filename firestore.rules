rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Запрещаем глобальный доступ ко всем документам по умолчанию
    match /{document=**} {
      allow read, write: if false;
    }

    // Вспомогательные функции валидации
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'contact', 'role', 'interest']) &&
        data.keys().hasOnly(['id', 'name', 'contact', 'role', 'interest', 'message', 'createdAt']) &&
        
        // Обязательные текстовые поля
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.contact is string && data.contact.size() > 0 && data.contact.size() <= 100 &&
        
        // Строгое соответствие значению из списков
        data.role in ['jury', 'investor', 'school', 'partner', 'user'] &&
        data.interest in ['investment', 'beta', 'partnership', 'other'] &&
        
        // Необязательные поля
        (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        
        // Поддержка как Timestamp (serverTimestamp/Date), так и строк
        (!('createdAt' in data) || (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 100)));
    }

    // Правила для коллекции лидов
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow get: if isValidId(leadId);
      allow list: if true;
    }
  }
}